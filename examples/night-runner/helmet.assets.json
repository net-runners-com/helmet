{
  "fontsSrc": "helmet/fonts-src",
  "faces": {
    "bangers": { "file": "Bangers-Regular.ttf", "family": "Bangers", "weight": "400", "style": "normal" },
    "barlow-500": { "file": "BarlowCondensed-Medium.ttf", "family": "Barlow Condensed", "weight": "500", "style": "normal" },
    "barlow-700": { "file": "BarlowCondensed-Bold.ttf", "family": "Barlow Condensed", "weight": "700", "style": "normal" },
    "barlow-600i": { "file": "BarlowCondensed-SemiBoldItalic.ttf", "family": "Barlow Condensed", "weight": "600", "style": "italic" },
    "barlow-800i": { "file": "BarlowCondensed-ExtraBoldItalic.ttf", "family": "Barlow Condensed", "weight": "800", "style": "italic" }
  },
  "variants": 8,
