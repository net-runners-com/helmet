{
  "name": "@helmet/example-night-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:legal": "helmet legal --name \"Night Runner\" --out static",
    "build:site": "vite build",
    "build:rendered": "node scripts/dump-rendered.mjs",
    "build:assets": "helmet assets helmet.assets.json",
    "build:allowlist": "helmet allowlist dist --out .helmet/public.json",
    "build:worker": "esbuild worker.js --bundle --format=esm --outfile=dist/_worker.js --log-level=warning",
    "build:audit": "helmet audit dist --copy .helmet/rendered.json --ignore \"Night Runner\"",
    "build": "npm run build:legal && npm run build:site && npm run build:rendered && npm run build:assets && npm run build:allowlist && npm run build:worker && npm run build:audit",
    "dev": "npm run build && wrangler pages dev dist --port 8793",
    "test": "node --test test/*.test.mjs",
    "lottie": "node scripts/make-lottie.mjs"
  },
  "dependencies": {
    "@helmet/core": "0.1.0",
    "@helmet/runtime": "0.1.0",
    "@helmet/worker": "0.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lottie-web": "^5.13.0"
  },
  "devDependencies": {
    "@helmet/build": "0.1.0",
    "@helmet/cli": "0.1.0",
    "cloakbrowser": "^0.5.11",
    "playwright-core": "^1.63.0"
  }
}
