{
  "name": "@helmet/example-minimal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:legal": "helmet legal --name \"Helmet demo\" --out public --email hello@example.com",
    "build:site": "vite build",
    "build:rendered": "node scripts/dump-rendered.mjs",
    "build:assets": "helmet assets helmet.assets.json",
    "build:allowlist": "helmet allowlist dist --out .helmet/public.json",
    "build:worker": "esbuild worker.js --bundle --format=esm --outfile=dist/_worker.js --log-level=warning",
    "build:audit": "helmet audit dist --copy .helmet/rendered.json",
    "build": "npm run build:legal && npm run build:site && npm run build:rendered && npm run build:assets && npm run build:allowlist && npm run build:worker && npm run build:audit",
    "dev": "npm run build && wrangler pages dev dist --port 8792"
  },
  "dependencies": {
    "@helmet/core": "0.1.0",
    "@helmet/runtime": "0.1.0",
    "@helmet/worker": "0.1.0"
  },
  "devDependencies": {
    "@helmet/build": "0.1.0",
    "@helmet/cli": "0.1.0"
  }
}
