{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helmet",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Every request goes through the Worker first so UA blocking and headers apply to all paths.
    "run_worker_first": true
  },
  // Decoy fonts and images are bundled into the Worker, never exposed as static files.
  "rules": [{ "type": "Data", "globs": ["**/*.woff2", "**/*.jpg"], "fallthrough": false }],
  "ratelimits": [{ "name": "RL", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    // Cloudflare's always-pass test key. Replace with a real widget key before going live.
    "TURNSTILE_SITEKEY": "1x00000000000000000000AA"
  },
  "observability": { "enabled": true }
}
